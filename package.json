{
  "name": "plainshot",
  "version": "0.1.0",
  "description": "Full page screenshot extension for Microsoft Edge and Google Chrome.",
  "private": true,
  "license": "MIT",
  "author": "Yoshiro Moriyama <7315004+moriyama-dev@users.noreply.github.com>",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/make-icons.mjs",
    "zip": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md}\"",
    "test": "node --test test/*.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "store-images": "node scripts/store-images.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.15.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
